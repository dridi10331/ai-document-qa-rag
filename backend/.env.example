ENVIRONMENT=dev
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_BACKEND=ollama
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_BACKEND=hf
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BATCH_SIZE=32
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
DB_URL=sqlite:///./data/app.db
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
ENABLE_OCR=false
VECTOR_INDEX_PATH=data/processed/faiss.index
VECTOR_META_PATH=data/processed/faiss_meta.json
BM25_PATH=data/processed/bm25.pkl
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_EXPANSION=true
QUERY_EXPANSION_MAX=3
BM25_WEIGHT=0.35
VECTOR_WEIGHT=0.65
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_TOKENS=1800
CHUNK_MIN_WORDS=120
CHUNK_MAX_WORDS=320
CHUNK_WINDOW_WORDS=260
CHUNK_OVERLAP_WORDS=60
ENABLE_ANALYTICS=true
COST_INPUT_PER_1K=0.005
COST_OUTPUT_PER_1K=0.015
