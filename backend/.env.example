ENVIRONMENT=dev

# LLM Backend (groq or ollama)
LLM_BACKEND=groq

# Groq API (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_BACKEND=hf
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BATCH_SIZE=32

# Storage
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
DB_URL=sqlite:///./data/app.db
MAX_UPLOAD_MB=50

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS_STR=http://localhost:3000

# OCR
ENABLE_OCR=false

# Vector Search
VECTOR_INDEX_PATH=data/processed/faiss.index
VECTOR_META_PATH=data/processed/faiss_meta.json
BM25_PATH=data/processed/bm25.pkl
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_EXPANSION=true
QUERY_EXPANSION_MAX=3
RERANKER_TYPE=llm
BM25_WEIGHT=0.35
VECTOR_WEIGHT=0.65

# Context
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_TOKENS=1800

# Chunking
CHUNK_MIN_WORDS=50
CHUNK_MAX_WORDS=200
CHUNK_WINDOW_WORDS=150
CHUNK_OVERLAP_WORDS=30

# Analytics
ENABLE_ANALYTICS=true
COST_INPUT_PER_1K=0.0
COST_OUTPUT_PER_1K=0.0

# Authentication (leave empty to disable auth)
API_KEY=
